          "id": "23fe201c-8a20-4ca4-8b38-6c85d4687b9e",
          "name": "Stream insights (SSE)",
          "request": {
            "name": "Stream insights (SSE)",
            "description": {
              "content": "Stream real-time insights via Server-Sent Events (SSE). On connect, recent insights are replayed as 'insight.replay' events (up to 20). New insights arrive as 'insight.batch.created' events. Keepalive comments are sent every 30 seconds.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "insights",
                "stream"
