        {
          "info": {
            "name": "Remove a record from a list",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.nex.ai/api/developers/v1/lists/:id/records/:record_id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "List ID"
              },
              {
                "name": "record_id",
                "value": "",
                "type": "path",
                "description": "Record ID"
              }
