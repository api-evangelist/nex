        {
          "info": {
            "name": "Get records from a specific list",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.nex.ai/api/developers/v1/lists/:id/records",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "List ID"
              }
